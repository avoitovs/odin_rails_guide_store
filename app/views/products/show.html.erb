<% cache @product do%>
<h1><%= @product.name%></h1>
<%= @product.description%>
<%= image_tag @product.featured_image if @product.featured_image.attached? %>
<% end %>
<%= link_to "Back", products_path %>
<%= button_to "Delete the product", product_path(@product.id), method: :delete if authenticated? %>
<%= button_to "Edit the product", edit_product_path(@product.id), method: :get if authenticated? %>


